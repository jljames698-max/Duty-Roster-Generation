# ── Server ─────────────────────────────────────────────
PORT=3001
# Vite dev client runs on 5173 and proxies /api to PORT above

# ── SharePoint Connection (DoD tenant) ────────────────
# Leave blank to run fully offline with local files / manual upload.
SHAREPOINT_TENANT=usmc.sharepoint-mil.us
SHAREPOINT_SITE=IMSBHeadquartersCompany
SHAREPOINT_CLIENT_ID=
SHAREPOINT_TENANT_ID=
SHAREPOINT_REDIRECT_URI=http://localhost:3001/auth/callback

# Folder paths within the document library
SP_ARCHIVE_PATH=OOD-AOOD Duty/Archive
SP_WORKING_PATH=OOD-AOOD Duty/Working
SP_REFERENCE_PATH=OOD-AOOD Duty/References

# ── Sync settings ─────────────────────────────────────
AUTO_SYNC_INTERVAL_MINUTES=60
STALE_MANPOWER_WARN_DAYS=7
